# .claudeignore - reference patterns only (not enforced by Claude Code)
# Claude Code does not read .claudeignore. These entries do not prevent it
# from opening secrets, reading files, or editing the paths listed below.
# For Claude Code's Read tool, configure permissions.deny rules in
# .claude/settings.json as described in the official documentation:
# https://code.claude.com/docs/en/permissions#read-and-edit
# Tool-specific denies are not an operating-system or shell sandbox.
# Keep secrets out of repositories and use filesystem permissions as needed.

# Infrastructure & Pipeline (read-only context only)
Jenkinsfile
docker-compose.yml
docker-compose.*.yml
monitoring/**
grafana/**

# Secrets & Environment
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Other developer workspaces
../workspace-dev2/**

# Git internals
.git/**

# Build artifacts (do not modify)
dist/
build/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
htmlcov/

# Dependencies (managed by Poetry/pip)
.venv/
venv/
node_modules/

# Agent-generated reports (read-only)
reports/**

# CI configuration
.github/**
jenkins/**
